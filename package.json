{
  "name": "@pirxpilot/pug-lint",
  "version": "3.0.0",
  "description": "An unopinionated and configurable linter and style checker for Pug (formerly Jade)",
  "author": "Ben Edwards <hello@benedfit.com>",
  "license": "ISC",
  "keywords": [
    "pug",
    "jade",
    "lint"
  ],
  "homepage": "https://github.com/pugjs/pug-lint",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pirxpilot/pug-lint.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "main": "./lib/linter",
  "bin": {
    "pug-lint": "bin/pug-lint"
  },
  "scripts": {
    "docs": "pliers buildRuleDocs",
    "schema": "pliers buildJsonSchema",
    "test": "make check"
  },
  "dependencies": {
    "acorn": "~7",
    "acorn-walk": "~7",
    "commander": "~14",
    "css-selector-parser": "^1.1.0",
    "find-line-column": "^0.5.2",
    "minimatch": "~10",
    "pug-attrs": "~3",
    "pug-error": "~2",
    "pug-lexer": "~5",
    "resolve": "^1.1.7",
    "strip-json-comments": "~5",
    "void-elements": "~3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "camel-case": "^3.0.0",
    "docco": "^0.7.0",
    "moment": "^2.11.2",
    "no-case": "^2.3.0",
    "pliers": "^1.2.1",
    "pug-lint-config-clock": "^1.1.0",
    "yeoman-generator": "^0.23.4"
  },
  "files": [
    "bin",
    "lib"
  ]
}
