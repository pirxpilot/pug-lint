    "pug-attrs": "~3",
    "pug-error": "~2",
    "pug-lexer": "~5",
    "resolve": "^1.1.7",
    "strip-json-comments": "^2.0.1",
    "void-elements": "^2.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "camel-case": "^3.0.0",
    "docco": "^0.7.0",
    "moment": "^2.11.2",
    "no-case": "^2.3.0",
    "pliers": "^1.2.1",
    "pug-lint-config-clock": "^1.1.0",
    "yeoman-generator": "^0.23.4"
