  "homepage": "https://github.com/pugjs/pug-lint",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/pugjs/pug-lint.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "main": "./lib/linter",
